# amoCRM
AMO_SUBDOMAIN=your_subdomain
AMO_TOKEN=your_long_lived_token

# Existing PostgreSQL on Windows (create this database in pgAdmin first).
# Compose uses host.docker.internal; localhost below is for standalone Python.
PG_HOST=localhost
PG_PORT=5432
PG_DB=amocrm_db
PG_USER=postgres
PG_PASSWORD=your_password
