# Secrets — never commit (contains the amoCRM token and DB password)
.env

# Raw API exports (regenerated by extract.py)
data/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Airflow runtime files; configuration templates stay in Git.
airflow/logs/*
!airflow/logs/.gitkeep
airflow/config/*
!airflow/config/.gitkeep
